{
  "name": "sketch2text",
  "version": "1.1.0",
  "description": "Converts handwritten pen strokes on the sketch canvas into typed text in real time for Flint.",
  "main": "dist/main.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "flint",
    "flint-extension",
    "sketch",
    "handwriting",
    "ocr",
    "pen-to-text"
  ],
  "author": "Yuliet Li <yuliet@flintnotes.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yvliet/sketch2text.git"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "flint": "^0.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  }
}
